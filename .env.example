# Postgres -- a local Postgres server, not a container. Create the role/db
# once with:
#   createuser cip --pwprompt --createdb   (or: psql postgres -c "CREATE USER cip WITH PASSWORD '...' CREATEDB;")
#   createdb -O cip cip
DATABASE_URL=postgresql+psycopg://cip:cip_dev_password@localhost:5432/cip

# Backend
LOG_LEVEL=info
ENV=development

# Ingestion guards
MAX_REPO_SIZE_MB=500
# Per-file parse guard, independent of MAX_REPO_SIZE_MB's total: a single
# file past this size is skipped (not parsed), bounding the worst-case
# parse time/memory a single file can cost regardless of repo size.
MAX_FILE_SIZE_MB=5
CLONE_TIMEOUT_SECONDS=60

# Background job safety net: a job still "running" after this many minutes
# is considered abandoned (e.g. a recycled web process) and re-claimed by
# startup reconciliation or the cron sweep (see backend/src/backend/jobs/sweep.py)
STALE_JOB_THRESHOLD_MINUTES=10

# Rate limiting on analyzeRepository (the only mutation that shells out to
# `git clone` and runs a full analysis): at most this many per client IP
# within the trailing window. Backed by Postgres (analysis_jobs.client_ip),
# not in-memory, so it holds across Passenger worker-process recycles.
RATE_LIMIT_MAX_ANALYSES=5
RATE_LIMIT_WINDOW_MINUTES=10

# Frontend (Vite requires VITE_ prefix)
VITE_GRAPHQL_URL=http://localhost:8000/graphql
