# Postgres
POSTGRES_USER=cip
POSTGRES_PASSWORD=cip_dev_password
POSTGRES_DB=cip
DATABASE_URL=postgresql+psycopg://cip:cip_dev_password@postgres:5432/cip

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_PORT=8000
LOG_LEVEL=info
ENV=development

# Ingestion guards
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=60

# Frontend (Vite requires VITE_ prefix)
VITE_GRAPHQL_URL=http://localhost:8000/graphql
FRONTEND_PORT=5173
